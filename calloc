#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    int *p;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    p = (int*) calloc(n, sizeof(int));

    if(p == NULL) {
        printf("Memory not allocated");
        return 0;
    }

    printf("Elements after calloc (default values):\n");
    for(i = 0; i < n; i++) {
        printf("%d ", p[i]);
    }

    free(p);  // free memory

    return 0;
}
